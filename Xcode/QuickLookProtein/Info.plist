	<!--
	  Sparkle 2.x configuration. The feed is hosted on GitHub Pages of this
	  fork; see docs/SPARKLE_SETUP.md for how to enable Pages and how the
	  release workflow keeps the appcast updated.
	-->
	<key>SUFeedURL</key>
	<string>https://ariomoniri.github.io/QuickLookProtein/appcast.xml</string>
	<!--
	  Public half of the EdDSA key generated by `generate_keys`. The value
	  shipped here is a *syntactically valid* but functionally bogus 32-byte
	  Ed25519 placeholder (base64 of 32 zero bytes). It's intentional: an
	  invalid-encoding placeholder makes Sparkle 2.x log
	      "The provided EdDSA key could not be decoded."
	      "Fatal updater error (1): The EdDSA public key is not valid for QuickLookProtein."
	  during framework load on every launch, *before* our Updater gate gets
	  a chance to suppress the controller. A well-formed zero-key decodes
	  cleanly and silences that boot-time error; signature checks against
	  the all-zero key still fail later, so unsigned/wrongly-signed builds
	  still won't install.
	  The release CI workflow rewrites this key at build time with the real
	  public key from the SPARKLE_ED_PUBLIC_KEY secret, so notarised
	  releases ship a real key and Sparkle works normally.
	-->
	<key>SUPublicEDKey</key>
	<string>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key>
