	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!--
	  Sparkle 2.x configuration. The feed is hosted on GitHub Pages of this
	  fork; see docs/SPARKLE_SETUP.md for how to enable Pages and how the
	  release workflow keeps the appcast updated.
	-->
	<key>SUFeedURL</key>
	<string>https://ariomoniri.github.io/QuickLookProtein/appcast.xml</string>
	<!--
	  Public half of the EdDSA key generated by `generate_keys` (see Sparkle
	  docs and scripts/generate-sparkle-keys.sh). Replace the placeholder
	  before shipping a notarised build, or Sparkle will refuse to install
	  anything because no signature it sees can match.
	-->
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_SPARKLE_PUBLIC_KEY_FROM_generate_keys</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
