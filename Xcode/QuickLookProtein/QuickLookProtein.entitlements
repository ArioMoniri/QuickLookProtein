<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.ariomoniri.QuickLookProtein</string>
	</array>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!--
	  Sparkle 2.x in a sandboxed app needs:

	   1. Outbound network (already set above) to fetch the appcast.xml
	      feed and the update artifact.

	   2. Permission to look up the XPC services Sparkle bundles for the
	      download/install steps that have to happen *outside* the
	      sandbox. The mach service names below MUST match the
	      `CFBundleIdentifier` of the two `.xpc` bundles we copy into
	      `Contents/XPCServices/` at release time (the release workflow
	      promotes them from `Sparkle.framework/Versions/B/XPCServices/`
	      and re-signs them with the rest of the app).

	      Previously we used `$(PRODUCT_BUNDLE_IDENTIFIER)-spks` /
	      `-spki` here. That naming required renaming the XPC service
	      bundles at build time, and because nothing was actually doing
	      that rename, Sparkle's installer-launcher couldn't find them
	      at runtime — clicking "Install Update" surfaced
	      "An error occurred while launching the installer." Switching
	      to the framework's stock identifiers (org.sparkle-project.*)
	      lets us ship the XPC services unchanged.

	  See https://sparkle-project.org/documentation/sandboxing/ for
	  background.
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>org.sparkle-project.InstallerLauncher</string>
		<string>org.sparkle-project.DownloaderService</string>
	</array>
</dict>
</plist>
