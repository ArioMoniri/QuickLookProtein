<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sparkle Downloader XPC service entitlements (sandboxed host).

  Network-client + app-sandbox + the shared App Group, per
  https://sparkle-project.org/documentation/sandboxing/. The
  downloader fetches the update .zip from the appcast's enclosure
  URL and writes it to the App Group container for the installer
  service to pick up.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)group.com.ariomoniri.QuickLookProtein</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
