<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows Explorer thumbnail provider for molecular structure files.

    Sibling project to QuickLookProtein.Plugin (which is the Space-bar
    preview plugin loaded by QL-Win). This DLL is a COM in-proc shell
    extension that Windows Explorer's thumbnail cache loads when the
    user has Icon / Tile / Gallery view turned on. It implements
    IThumbnailProvider + IInitializeWithStream from
    Microsoft.WindowsAPICodePack idioms - we hand-roll the COM
    interop here so we don't pull in a heavy dependency.

    Rendering is pure managed: parse the structure with our own
    PDB / MOL / MOL2 / XYZ parser, depth-sort the atoms, draw CPK
    spheres with System.Drawing onto a System.Drawing.Bitmap, then
    hand the HBITMAP back to Explorer. No WebView2 here - that would
    be far too slow for a thumbnail provider (Explorer paints
    hundreds of icons during a folder scroll).

    Registration is done by Windows/install.ps1 - it writes per-
    extension shell-handler keys under HKCU so no admin is required.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QuickLookProtein.Thumbnail</AssemblyName>
    <RootNamespace>QuickLookProtein.Thumbnail</RootNamespace>
    <!--
      We register COM via raw registry writes from install.ps1 rather
      than regasm, so RegisterForComInterop isn't needed at build time.
    -->
    <ComVisible>true</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
