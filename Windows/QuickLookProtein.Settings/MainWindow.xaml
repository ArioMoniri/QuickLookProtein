<Window x:Class="QuickLookProtein.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickLookProtein Settings"
        Height="780" Width="900"
        MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#16181C"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="#E8EAED">
    <!--
      Settings UI for the Windows side. Mirrors the macOS app's tile
      layout: left panel = per-format atom-display style + global
      rendering options + appearance, right panel = an About / quick
      tips card. No tabs - everything fits in a single scrollable
      surface so users can see at a glance what's configurable.
      Looks good on both light + dark themes; we paint our own
      surfaces so the contrast doesn't change with system theme.
    -->
    <Window.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- Subtle paragraph text -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9DA3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Row label -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CFD2D6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Card surface (the visual chunks) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1F2228"/>
            <Setter Property="BorderBrush" Value="#2A2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Compact, square-ish ComboBox so per-format rows line up -->
        <Style x:Key="StyleCombo" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Bold pill CTA -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3D6BE0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border Grid.Row="0" Background="#13151A" Padding="18,14"
                BorderBrush="#23262D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="QuickLookProtein"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="3D molecular preview for Windows Explorer"
                           FontSize="12" Foreground="#9A9DA3" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="18,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: per-format atom style + rendering + appearance -->
                <StackPanel Grid.Column="0">

                    <!-- Live preview tiles. Mirrors the macOS app's
                         tile grid: a single WebView2 hosting 3Dmol.js
                         (same renderer the QL plugin uses), with a
                         row of format buttons that swap in different
                         sample files. Settings changes apply on the
                         next "Reload" click so users can sanity-check
                         how their preferences affect a real preview. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Live preview"
                                           Style="{StaticResource SectionTitle}"/>
                                <Button Grid.Column="1"
                                        Content="Reload"
                                        Padding="10,4" Margin="0,8,0,0"
                                        Cursor="Hand"
                                        Click="ReloadPreview_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Click a file format to render one of the bundled samples right here. Uses the same 3Dmol.js the Space-bar preview uses, with the settings you have above."/>

                            <!-- Tile row: one button per format -->
                            <WrapPanel x:Name="FormatTilesWrap" Margin="0,4,0,8"/>

                            <!-- The live viewport -->
                            <Border Background="#0E0E10"
                                    BorderBrush="#2A2E36" BorderThickness="1"
                                    CornerRadius="8" Height="320">
                                <wv2:WebView2 x:Name="PreviewWebView"/>
                            </Border>

                            <TextBlock x:Name="PreviewCaption"
                                       Style="{StaticResource Caption}"
                                       Text="Loading..." Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-format atom style -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Atom display style"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="How each file format renders by default. Cartoon for proteins, sticks for small molecules, spheres for crystals - or whatever you prefer. Settings apply immediately to the next Space-bar preview."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="PDB:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="PdbStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="CIF:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="CifStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="SDF:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="SdfStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Text="MOL:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="MolStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal">
                                    <TextBlock Text="MOL2:" Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="Mol2StyleCombo" Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal">
                                    <TextBlock Text="XYZ:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="XyzStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="GRO:"   Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="GroStyleCombo"   Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="CUBE:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="CubeStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="PQR:"   Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="PqrStyleCombo"   Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Text="VASP:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="VaspStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal">
                                    <TextBlock Text="CDJSON:" Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="CdjsonStyleCombo" Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal">
                                    <TextBlock Text="MMTF:"  Style="{StaticResource RowLabel}"/>
                                    <ComboBox  x:Name="MmtfStyleCombo"  Style="{StaticResource StyleCombo}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Global color scheme, rotation, and starting zoom. Background is applied behind the molecule in every preview."/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Color scheme:" VerticalAlignment="Center"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="ColorSchemeCombo"
                                           HorizontalAlignment="Left" MinWidth="200" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation:" VerticalAlignment="Center"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="RotationCombo"
                                           HorizontalAlignment="Left" MinWidth="200" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Default zoom:" VerticalAlignment="Center"/>
                                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="ZoomCombo"
                                           HorizontalAlignment="Left" MinWidth="200" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Background:" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <Border x:Name="BgSwatch" Width="32" Height="20"
                                            BorderBrush="#404550" BorderThickness="1"
                                            CornerRadius="3" Margin="0,4,8,4"
                                            Background="Black"/>
                                    <Button x:Name="BgPickButton" Content="Choose color..."
                                            Padding="10,4" Margin="0,4"
                                            Cursor="Hand"
                                            Click="BgPickButton_Click"/>
                                    <Button x:Name="BgResetButton" Content="Transparent"
                                            Padding="10,4" Margin="6,4,0,4"
                                            Cursor="Hand"
                                            Click="BgResetButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Rendering options -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Rendering options"
                                       Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="AutoStyleHeteroCheck"
                                      Content="Smart protein + ligand styling"
                                      ToolTip="When a file has both a polymer and a ligand, render the polymer with the chosen style and ligands as sticks."
                                      Margin="0,4"/>
                            <CheckBox x:Name="ShowSurfaceCheck"
                                      Content="Show molecular surface"
                                      Margin="0,4"/>
                            <CheckBox x:Name="HideHydrogensCheck"
                                      Content="Hide hydrogens"
                                      Margin="0,4"/>
                            <CheckBox x:Name="ShowUnitCellCheck"
                                      Content="Show unit cell (CIF)"
                                      Margin="0,4"/>
                            <CheckBox x:Name="ShowInfoOverlayCheck"
                                      Content="Show info overlay"
                                      Margin="0,4"/>
                            <CheckBox x:Name="ShowControlsInPreviewCheck"
                                      Content="Show interactive controls"
                                      ToolTip="Adds a small bottom-right toolbar in every Quick Look preview with one-click buttons for Stick / Line / Sphere / Cartoon style, Surface, Color SS, Label alpha-C, and Recenter."
                                      Margin="0,4"/>
                            <CheckBox x:Name="OutlineShadingCheck"
                                      Content="Outline shading"
                                      ToolTip="Adds a thin dark border around every atom/bond. Makes the preview pop on light backgrounds."
                                      Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Toolbar buttons - per-button visibility. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Toolbar buttons"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Hide any individual button from the bottom-right toolbar. Useful for smaller previews."/>
                            <CheckBox x:Name="CtlShowStickCheck"    Content="Stick"    Margin="0,4"/>
                            <CheckBox x:Name="CtlShowLineCheck"     Content="Line"     Margin="0,4"/>
                            <CheckBox x:Name="CtlShowSphereCheck"   Content="Sphere"   Margin="0,4"/>
                            <CheckBox x:Name="CtlShowCartoonCheck"  Content="Cartoon"  Margin="0,4"/>
                            <CheckBox x:Name="CtlShowSurfaceCheck"  Content="Surface"  Margin="0,4"/>
                            <CheckBox x:Name="CtlShowColorSSCheck"  Content="Color SS" Margin="0,4"/>
                            <CheckBox x:Name="CtlShowLabelCACheck"  Content="Label alpha-C" Margin="0,4"/>
                            <CheckBox x:Name="CtlShowRecenterCheck" Content="Recenter" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Info overlay fields. Each piece of the
                         "filename · atoms · chains · format" pill is
                         a separate toggle. Disabled visually when
                         the master "Show info overlay" toggle above
                         is off, but the user can still flip these in
                         advance. Mirrors the macOS settings panel. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Info overlay fields"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Which bits of information appear in the info pill at the top-left of every preview. Gated on the 'Show info overlay' toggle above."/>
                            <CheckBox x:Name="InfoFileNameCheck"        Content="File name"          Margin="0,4"/>
                            <CheckBox x:Name="InfoAtomCountCheck"       Content="Atom count"         Margin="0,4"/>
                            <CheckBox x:Name="InfoChainCountCheck"      Content="Chain count"        Margin="0,4"/>
                            <CheckBox x:Name="InfoResidueCountCheck"    Content="Residue count"      Margin="0,4"/>
                            <CheckBox x:Name="InfoElementBreakdownCheck"
                                      Content="Element breakdown"
                                      ToolTip="Top four most abundant elements with counts, e.g. 'C:120 N:36 O:30 H:24'."
                                      Margin="0,4"/>
                            <CheckBox x:Name="InfoMolWeightCheck"
                                      Content="Molecular weight"
                                      ToolTip="Sum of standard atomic masses (Da / kDa above 1000)."
                                      Margin="0,4"/>
                            <CheckBox x:Name="InfoBondCountCheck"       Content="Bond count"         Margin="0,4"/>
                            <CheckBox x:Name="InfoPDBTitleCheck"
                                      Content="PDB title"
                                      ToolTip="First TITLE record from the PDB header. Only meaningful for .pdb / .ent files."
                                      Margin="0,4"/>
                            <CheckBox x:Name="InfoFormatCheck"          Content="File format"        Margin="0,4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: About + Tips -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionLabel"
                                       Text="Version"
                                       Foreground="#CFD2D6"
                                       Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Original Quick Look extension by Jethro Hemmann (2021-2022). Multi-format upgrade, Windows port, Sparkle auto-update by Ariorad Moniri (2026)."/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Rendering by 3Dmol.js (Rego &amp; Koes, 2015)."/>
                            <Button Content="Open GitHub"
                                    HorizontalAlignment="Left"
                                    Padding="10,4" Margin="0,6,0,0"
                                    Cursor="Hand"
                                    Click="GithubButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tips"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Press SPACE on a .pdb / .cif / .mol2 / .xyz / etc. file in Explorer to preview it via QuickLook."/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Folders in Icon / Tile / Gallery view show CPK or cartoon-ribbon thumbnails of every supported file."/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Settings here apply on the NEXT preview - no need to restart QuickLook."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Trouble?"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="If thumbnails don't refresh, right-click the QuickLook tray icon, choose Exit, then relaunch QuickLook from the Start Menu. Or sign out and back in to clear Explorer's icon cache."/>
                            <Button Content="Open plugin folder"
                                    HorizontalAlignment="Left"
                                    Padding="10,4" Margin="0,6,0,0"
                                    Cursor="Hand"
                                    Click="OpenPluginFolderButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Diagnostics"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="If Space-bar still shows a file as plain text, the plugin didn't load. Open the logs below and check for TypeLoadException or missing-dependency errors."/>
                            <Button Content="Open plugin log"
                                    HorizontalAlignment="Left"
                                    Padding="10,4" Margin="0,2"
                                    Cursor="Hand"
                                    Click="OpenPluginLog_Click"/>
                            <Button Content="Open QuickLook log"
                                    HorizontalAlignment="Left"
                                    Padding="10,4" Margin="0,2"
                                    Cursor="Hand"
                                    Click="OpenQuickLookLog_Click"/>
                            <Button Content="Restart QuickLook tray"
                                    HorizontalAlignment="Left"
                                    Padding="10,4" Margin="0,2"
                                    Cursor="Hand"
                                    Click="RestartQuickLookTray_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#13151A" Padding="18,12"
                BorderBrush="#23262D" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusLabel"
                           Text="Changes save instantly."
                           Foreground="#9A9DA3" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <Button Content="Close" Style="{StaticResource PrimaryButton}"
                        Width="100" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
