<Window x:Class="QuickLookProtein.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickLookProtein2 Settings"
        Height="660" Width="820"
        MinHeight="580" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{DynamicResource TextPrimary}"
        Icon="pack://application:,,,/Resources/AppIcon.ico">
    <!--
      Windows Settings UI for QuickLookProtein2 — v1.7.81 redesign.
      Mac-System-Settings-style sidebar nav + system-following light/dark theme.
      On Win11 the window paints over a Mica backdrop (set via DwmSetWindowAttribute
      from code-behind); on older Windows we fall back to opaque AppBg.

      All theme-sensitive colours are DynamicResource so the code-behind can
      flip the active palette when Windows switches between light & dark mode
      (we listen to SystemEvents.UserPreferenceChanged).

      Adding a new card: drop it inside one of the existing
      <StackPanel x:Name="*Tab"> containers; the nav-list on the left
      toggles each tab's Visibility.
    -->
    <Window.Resources>
        <!--
          Theme brushes — defaults are the LIGHT palette so the XAML
          designer + first-paint look right. Code-behind swaps brush
          .Color in ApplyTheme() when the system is in dark mode or
          flips between modes.

          Colour values follow Windows 11's Fluent palette
          (https://learn.microsoft.com/en-us/windows/apps/design/style/color)
          so the window blends with native chrome.
        -->
        <SolidColorBrush x:Key="AppBg"            Color="Transparent"/>
        <SolidColorBrush x:Key="SidebarBg"        Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ContentBg"        Color="#FAFAFA"/>
        <SolidColorBrush x:Key="CardBg"           Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardStroke"       Color="#E5E5E5"/>
        <SolidColorBrush x:Key="HoverBg"          Color="#EFEFEF"/>
        <SolidColorBrush x:Key="PressedBg"        Color="#E3E3E3"/>
        <SolidColorBrush x:Key="NavSelectedBg"    Color="#E5F1FB"/>
        <SolidColorBrush x:Key="NavSelectedStroke" Color="#0067C0"/>
        <SolidColorBrush x:Key="TextPrimary"      Color="#1F1F1F"/>
        <SolidColorBrush x:Key="TextSecondary"    Color="#5C5C5C"/>
        <SolidColorBrush x:Key="TextMuted"        Color="#8B8B8B"/>
        <SolidColorBrush x:Key="Accent"           Color="#0067C0"/>
        <SolidColorBrush x:Key="AccentHover"      Color="#1A77CC"/>
        <SolidColorBrush x:Key="AccentPressed"    Color="#005AA0"/>
        <SolidColorBrush x:Key="WarnBg"           Color="#FFF4CE"/>
        <SolidColorBrush x:Key="WarnText"         Color="#5B4500"/>
        <SolidColorBrush x:Key="ErrBg"            Color="#FDE7E9"/>
        <SolidColorBrush x:Key="ErrText"          Color="#8E1726"/>

        <!-- Typography styles -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!--
          Card surface — Win11 Fluent: white in light mode, dark grey in
          dark mode, 8px corner radius, 1px stroke. No drop shadow: with
          Mica behind the window, shadows clash with the system blur.
        -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StyleCombo" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!--
          Primary CTA pill — accent fill, white text, 4px Win11 corner radius.
        -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Secondary button — light-gray surface, dark text, 4px radius.
          This is the implicit Button style so plain <Button>s look
          modern without per-instance Style="…".
        -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardStroke}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource PressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <!--
          Win11-style CheckBox — small rounded-square indicator, accent fill
          when checked. Replaces WPF's chunky default that doesn't match the
          rest of Fluent design.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box"
                                    Width="18" Height="18"
                                    CornerRadius="3"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource TextMuted}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick"
                                      Data="M 4 9 L 8 13 L 14 6"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Slimmer Slider — smaller thumb, accent fill, suppresses mouse-wheel
          (which previously made the slider so jumpy users couldn't pick a
          value reliably). SmallChange/LargeChange are tuned wider in
          MainWindow_Loaded based on per-slider range.
        -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource CardStroke}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
        </Style>

        <!--
          TextBox — Win11 outline style with rounded corners.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!--
          ComboBox — adopts Card surface so dropdowns blend with cards.
        -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!--
          Win11-style ScrollBar — thin track (8px), rounded thumb that
          fattens slightly on hover. Replaces WPF's default chunky
          chrome (arrow buttons, square thumb) that didn't match the
          rest of the Fluent surfaces. Implicit style: every
          ScrollBar in the window picks this up without per-instance
          Style="…".
        -->
        <Style TargetType="{x:Type RepeatButton}" x:Key="ScrollBarLineButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" Width="8" Height="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type RepeatButton}" x:Key="ScrollBarPageButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Thumb}" x:Key="ScrollBarThumb">
            <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2"
                                Opacity="0.55"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                          Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                          Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          Sidebar nav item — Mac-System-Settings vibe. Selected item gets a
          subtle accent-tinted background and a vertical accent stripe on
          the left. Hover gets a faint surface tint.
        -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg"
                                CornerRadius="5"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="stripe"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        CornerRadius="2"
                                        Margin="0,4"
                                        Width="3"
                                        HorizontalAlignment="Left"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource NavSelectedBg}"/>
                                <Setter TargetName="stripe" Property="Background"
                                        Value="{DynamicResource NavSelectedStroke}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Root: 2-column Grid. Left = 220px sidebar, right = content + footer.
      Window background is set to AppBg (transparent on Win11 for Mica;
      ContentBg fallback on Win10).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================== SIDEBAR =================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource CardStroke}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header: logo + name + version.
                     v1.7.83+ loads the real 256-px PNG (extracted from
                     the ICO's largest frame at build time and shipped
                     as Resources\AppLogo-256.png). The v1.7.82 attempt
                     to use <BitmapImage UriSource="...ico"
                     DecodePixelWidth="256"/> didn't actually upscale
                     correctly — DecodePixelWidth is a no-op on multi-
                     frame ICOs, and WPF's IconBitmapDecoder still
                     returned Frames[0] (the 16-px entry). Sourcing
                     a real PNG sidesteps the quirk entirely. -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                    <Image Source="pack://application:,,,/Resources/AppLogo-256.png"
                           Width="56" Height="56"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Left"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                    <TextBlock Text="QuickLookProtein2"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="VersionLabel"
                               Text="Version"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nav list. SelectionChanged routes to ShowTab() in code-behind. -->
                <ListBox x:Name="NavList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="NavList_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="General" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="FileFormats">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="File Formats" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Rendering">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Rendering" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Toolbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Toolbar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="InfoOverlay">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Info Overlay" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Thumbnails">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thumbnails" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Update">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Software Update" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- =================== CONTENT =================== -->
        <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bottom padding stays generous (24) so the WebView2 in
                 Live Preview is well clear of the footer when scrolled
                 to top — the WPF airspace problem means WebView2 (HWND)
                 doesn't always honour ScrollViewer clipping during
                 scroll animations, and a generous gap keeps the
                 overlap from being visible. -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,22,28,24">
                <Grid>
                    <!-- ====== GENERAL TAB ====== -->
                    <StackPanel x:Name="GeneralTab">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Live preview, Explorer integration, and the size QuickLook opens at."
                                   Style="{StaticResource SectionSubtitle}"/>

                        <!-- Live preview card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Live preview" Style="{StaticResource CardTitle}"/>
                                    <Button Grid.Column="1" Content="Reload" Padding="10,4" Click="ReloadPreview_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Click a file format to render one of the bundled samples right here. Uses the same 3Dmol.js the Space-bar preview uses, with the settings you have above."/>
                                <WrapPanel x:Name="FormatTilesWrap" Margin="0,4,0,8"/>
                                <!-- WebView2 is HWND-hosted and paints on top of
                                     WPF (the "airspace" problem). Height stays
                                     fixed and modest so the live-preview tile can
                                     never visually intersect the footer when the
                                     user scrolls. Border ClipToBounds limits the
                                     WPF painting; the HWND itself is repositioned
                                     by the CoreWebView2Controller when the
                                     ScrollViewer arranges. -->
                                <Border Background="#0E0E10"
                                        BorderBrush="{DynamicResource CardStroke}"
                                        BorderThickness="1"
                                        CornerRadius="6" Height="260"
                                        ClipToBounds="True">
                                    <wv2:WebView2 x:Name="PreviewWebView"/>
                                </Border>
                                <TextBlock x:Name="PreviewCaption"
                                           Style="{StaticResource Caption}"
                                           Text="Loading..." Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview window size card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Preview window size" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Initial size of the QuickLook preview popover when you press Space on a structure file. Drag-resize the preview itself for ad-hoc adjustments — QL-Win remembers your last size across files."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="2"
                                            x:Name="PreviewWidthSlider"
                                            Minimum="240" Maximum="2400"
                                            SmallChange="20" LargeChange="80"
                                            TickFrequency="80"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,6"/>
                                    <TextBox Grid.Row="0" Grid.Column="4"
                                             x:Name="PreviewWidthBox"
                                             Width="72" Margin="0,6"
                                             HorizontalContentAlignment="Right"
                                             ToolTip="Width in pixels (240 - 2400)"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Height:" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="2"
                                            x:Name="PreviewHeightSlider"
                                            Minimum="180" Maximum="2400"
                                            SmallChange="20" LargeChange="80"
                                            TickFrequency="60"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="4"
                                             x:Name="PreviewHeightBox"
                                             Width="72" Margin="0,6"
                                             HorizontalContentAlignment="Right"
                                             ToolTip="Height in pixels (180 - 2400)"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Compact (480 × 360)" Margin="0,0,6,0" Click="PreviewSize_Compact_Click"/>
                                    <Button Content="Default (560 × 420)" Margin="0,0,6,0" Click="PreviewSize_Default_Click"/>
                                    <Button Content="Large (960 × 720)" Click="PreviewSize_Large_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Startup card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Whether QuickLook (the host app that loads our plugin) launches automatically when you sign in to Windows. Without this, Space-bar previews only work after you manually launch QuickLook from the Start Menu."/>
                                <CheckBox x:Name="LaunchAtStartupCheck"
                                          Content="Launch QuickLook at sign-in"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== FILE FORMATS TAB ====== -->
                    <StackPanel x:Name="FileFormatsTab" Visibility="Collapsed">
                        <TextBlock Text="File Formats" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Atom display style per file format — cartoon for proteins, sticks for small molecules, spheres for crystals."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Atom display style" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Settings apply immediately to the next Space-bar preview."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="PDB:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="PdbStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="CIF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="CifStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="SDF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="SdfStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                                        <TextBlock Text="MOL:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="MolStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal">
                                        <TextBlock Text="MOL2:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="Mol2StyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal">
                                        <TextBlock Text="XYZ:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="XyzStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="GRO:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="GroStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="CUBE:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="CubeStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="PQR:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="PqrStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal">
                                        <TextBlock Text="VASP:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="VaspStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal">
                                        <TextBlock Text="CDJSON:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="CdjsonStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal">
                                        <TextBlock Text="MMTF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="MmtfStyleCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== APPEARANCE TAB ====== -->
                    <StackPanel x:Name="AppearanceTab" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Global color scheme, rotation, starting zoom, and background colour applied behind the molecule."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Color scheme:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ColorSchemeCombo"
                                              HorizontalAlignment="Left" MinWidth="220" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RotationCombo"
                                              HorizontalAlignment="Left" MinWidth="220" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Default zoom:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ZoomCombo"
                                              HorizontalAlignment="Left" MinWidth="220" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Background:" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <Border x:Name="BgSwatch" Width="32" Height="20"
                                                BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                                                CornerRadius="3" Margin="0,4,8,4"
                                                Background="Black"/>
                                        <Button x:Name="BgPickButton" Content="Choose color..." Padding="10,4" Margin="0,4" Click="BgPickButton_Click"/>
                                        <Button x:Name="BgResetButton" Content="Transparent" Padding="10,4" Margin="6,4,0,4" Click="BgResetButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== RENDERING TAB ====== -->
                    <StackPanel x:Name="RenderingTab" Visibility="Collapsed">
                        <TextBlock Text="Rendering" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Visualisation features applied on every Quick Look preview."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Rendering options" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="AutoStyleHeteroCheck" Content="Smart protein + ligand styling"
                                          ToolTip="When a file has both a polymer and a ligand, render the polymer with the chosen style and ligands as sticks."/>
                                <CheckBox x:Name="ShowSurfaceCheck" Content="Show molecular surface"/>
                                <CheckBox x:Name="HideHydrogensCheck" Content="Hide hydrogens"/>
                                <CheckBox x:Name="ShowUnitCellCheck" Content="Show unit cell (CIF)"/>
                                <CheckBox x:Name="ShowInfoOverlayCheck" Content="Show info overlay"/>
                                <CheckBox x:Name="ShowControlsInPreviewCheck" Content="Show interactive controls"
                                          ToolTip="Adds a small bottom-right toolbar in every Quick Look preview with one-click buttons for Stick / Line / Sphere / Cartoon style, Surface, Color SS, Label alpha-C, and Recenter."/>
                                <CheckBox x:Name="OutlineShadingCheck" Content="Outline shading"
                                          ToolTip="Adds a thin dark border around every atom/bond. Makes the preview pop on light backgrounds."/>
                                <CheckBox x:Name="AmbientOcclusionCheck" Content="Ambient occlusion"
                                          ToolTip="CSS vignette over the WebGL canvas that deepens edges, giving a low-cost pseudo-AO effect. Auto-disabled for stick/line previews of small molecules so atoms don't get washed out."/>
                                <CheckBox x:Name="AutoOrientCheck" Content="Auto-orient (longest axis horizontal)"
                                          ToolTip="Rotate the molecule so its longest principal axis is horizontal. Useful for screenshots; gives every preview a deterministic canonical pose."/>
                                <CheckBox x:Name="CubeIsosurfaceCheck" Content="Cube isosurface"
                                          ToolTip="Render Gaussian Cube files as +/- isovalue isosurfaces (blue/red) instead of bare atoms. Useful for orbital / electron-density plots."/>
                                <CheckBox x:Name="BioAssemblyCheck" Content="Biological assembly"
                                          ToolTip="Expand PDB / CIF files into their full biological assembly using REMARK 350 (PDB) or _pdbx_struct_oper_list (CIF) transformations. Off: show only the asymmetric unit."/>
                                <CheckBox x:Name="CryoEMRenderCheck" Content="Cryo-EM density isosurface"
                                          ToolTip="Render .ccp4 / .mrc / .map files as a volumetric isosurface. (macOS-only for now; Windows still falls back to QL-Win's default viewer for these files.)"/>
                                <CheckBox x:Name="ShowShareButtonCheck" Content="Share button in preview"
                                          ToolTip="Adds a Share button to the toolbar that captures the current rendering as PNG and presents the system Sharing picker."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== TOOLBAR TAB ====== -->
                    <StackPanel x:Name="ToolbarTab" Visibility="Collapsed">
                        <TextBlock Text="Toolbar" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Per-button visibility for the bottom-right toolbar in every preview."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Toolbar buttons" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="CtlShowStickCheck" Content="Stick"/>
                                <CheckBox x:Name="CtlShowLineCheck" Content="Line"/>
                                <CheckBox x:Name="CtlShowSphereCheck" Content="Sphere"/>
                                <CheckBox x:Name="CtlShowCartoonCheck" Content="Cartoon"/>
                                <CheckBox x:Name="CtlShowSurfaceCheck" Content="Surface"/>
                                <CheckBox x:Name="CtlShowColorSSCheck" Content="Color SS"/>
                                <CheckBox x:Name="CtlShowLabelCACheck" Content="Label alpha-C"/>
                                <CheckBox x:Name="CtlShowRecenterCheck" Content="Recenter"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== INFO OVERLAY TAB ====== -->
                    <StackPanel x:Name="InfoOverlayTab" Visibility="Collapsed">
                        <TextBlock Text="Info Overlay" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Which bits of information appear in the info pill at the top-left of every preview. Gated on the master 'Show info overlay' toggle under Rendering."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Info overlay fields" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="InfoFileNameCheck" Content="File name"/>
                                <CheckBox x:Name="InfoAtomCountCheck" Content="Atom count"/>
                                <CheckBox x:Name="InfoChainCountCheck" Content="Chain count"/>
                                <CheckBox x:Name="InfoResidueCountCheck" Content="Residue count"/>
                                <CheckBox x:Name="InfoElementBreakdownCheck" Content="Element breakdown"
                                          ToolTip="Top four most abundant elements with counts, e.g. 'C:120 N:36 O:30 H:24'."/>
                                <CheckBox x:Name="InfoMolWeightCheck" Content="Molecular weight"
                                          ToolTip="Sum of standard atomic masses (Da / kDa above 1000)."/>
                                <CheckBox x:Name="InfoBondCountCheck" Content="Bond count"/>
                                <CheckBox x:Name="InfoPDBTitleCheck" Content="PDB title"
                                          ToolTip="First TITLE record from the PDB header. Only meaningful for .pdb / .ent files."/>
                                <CheckBox x:Name="InfoFormatCheck" Content="File format"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== THUMBNAILS TAB (NEW) ====== -->
                    <StackPanel x:Name="ThumbnailsTab" Visibility="Collapsed">
                        <TextBlock Text="Thumbnails" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Style applied to thumbnails in Icon / Tile / Gallery view. 'Auto' uses cartoon-ribbon for proteins (multiple CA atoms) and CPK for small molecules."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thumbnail style per format" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Changes apply after the next thumbnail re-fetch. Use the 'Refresh thumbnails' button under About → Diagnostics to force Explorer to redraw."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="PDB:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbPdbCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="CIF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbCifCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="SDF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbSdfCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                                        <TextBlock Text="MOL:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbMolCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal">
                                        <TextBlock Text="MOL2:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbMol2Combo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal">
                                        <TextBlock Text="XYZ:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbXyzCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="GRO:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbGroCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="CUBE:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbCubeCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="PQR:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbPqrCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal">
                                        <TextBlock Text="VASP:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbVaspCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal">
                                        <TextBlock Text="CDJSON:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbCdjsonCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal">
                                        <TextBlock Text="MMTF:" Style="{StaticResource RowLabel}"/>
                                        <ComboBox x:Name="ThumbMmtfCombo" Style="{StaticResource StyleCombo}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Reset to Auto"
                                            Click="ThumbStyle_ResetAll_Click"
                                            Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="Refresh thumbnails now"
                                            Click="RefreshThumbnails_Click"
                                            Padding="10,4"
                                            ToolTip="Force Explorer to re-query thumbnail handlers for our extensions. Run this if .pdb / .cif files in Icon view show as blank/white icons after install."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== SOFTWARE UPDATE TAB ====== -->
                    <StackPanel x:Name="UpdateTab" Visibility="Collapsed">
                        <TextBlock Text="Software Update" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="In-app updater. Pings GitHub's releases endpoint, downloads QuickLookProtein-Setup.exe, and re-runs Setup.exe to upgrade in place."
                                   Style="{StaticResource SectionSubtitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatusLabel"
                                           Style="{StaticResource Caption}"
                                           Text="Checking installed version..."/>
                                <TextBlock x:Name="UpdateNotesLabel"
                                           Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxHeight="220"
                                           Visibility="Collapsed"/>
                                <WrapPanel Margin="0,4,0,4">
                                    <Button x:Name="CheckForUpdatesButton"
                                            Content="Check for updates"
                                            Padding="10,4" Margin="0,0,6,6"
                                            Click="CheckForUpdates_Click"/>
                                    <Button x:Name="InstallUpdateButton"
                                            Content="Install update"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" Margin="0,0,6,6"
                                            Visibility="Collapsed"
                                            Click="InstallUpdate_Click"/>
                                    <Button x:Name="OpenReleasePageButton"
                                            Content="Open release page"
                                            Padding="10,4" Margin="0,0,6,6"
                                            Visibility="Collapsed"
                                            Click="OpenReleasePage_Click"/>
                                    <Button x:Name="OpenUpdateLogButton"
                                            Content="Open update log"
                                            Padding="10,4" Margin="0,0,0,6"
                                            ToolTip="Open the rolling log written by every update check / install attempt. Useful when an install silently fails."
                                            Click="OpenUpdateLog_Click"/>
                                </WrapPanel>
                                <CheckBox x:Name="AutoCheckUpdatesCheck"
                                          Content="Check for updates automatically when this window opens"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====== ABOUT TAB ====== -->
                    <StackPanel x:Name="AboutTab" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Credits, tips, and diagnostics."
                                   Style="{StaticResource SectionSubtitle}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="QuickLookProtein2" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="VersionLabelAbout"
                                           Text="Version"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="Originally built by "/>
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Jethro Hemmann"/>
                                    <Run Text=" (2021-2022) — the original QuickLookProtein."/>
                                </TextBlock>
                                <Button Content="Original repo (JethroHemmann/QuickLookProtein)"
                                        HorizontalAlignment="Left"
                                        Padding="10,4" Margin="0,2,0,6"
                                        Click="OriginalRepoButton_Click"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Extended by Ariorad Moniri (2026) as QuickLookProtein2 — multi-format support, smart protein+ligand styling, molecular surfaces, Windows port, in-app updater."/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Rendering by 3Dmol.js (Rego &amp; Koes, 2015)."/>
                                <Button Content="This fork (ArioMoniri/QuickLookProtein)"
                                        HorizontalAlignment="Left"
                                        Padding="10,4" Margin="0,6,0,0"
                                        Click="GithubButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tips" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Press SPACE on a .pdb / .cif / .mol2 / .xyz / etc. file in Explorer to preview it via QuickLook."/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Folders in Icon / Tile / Gallery view show CPK or cartoon-ribbon thumbnails of every supported file."/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Settings here apply on the NEXT preview — no need to restart QuickLook."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="If Space-bar still shows a file as plain text, the plugin didn't load. Open the logs below and check for TypeLoadException or missing-dependency errors."/>
                                <WrapPanel>
                                    <Button Content="Open plugin folder" Padding="10,4" Margin="0,2,6,2" Click="OpenPluginFolderButton_Click"/>
                                    <Button Content="Open plugin log" Padding="10,4" Margin="0,2,6,2" Click="OpenPluginLog_Click"/>
                                    <Button Content="Test thumbnail provider" Padding="10,4" Margin="0,2,6,2"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Walk the registration chain: per-extension key → CLSID → managed DLL load → COM CreateInstance. Pinpoints whether Explorer can't find us, can't load the DLL, or fails CLR activation. Writes results to thumbnail.log."
                                            Click="TestThumbnailProvider_Click"/>
                                    <Button Content="Open thumbnail log" Padding="10,4" Margin="0,2,6,2"
                                            ToolTip="Open the rolling log written by the Explorer thumbnail provider. Empty means Explorer never loaded our DLL; entries with parse / render errors point at the specific failure."
                                            Click="OpenThumbnailLog_Click"/>
                                    <Button Content="Open QuickLook log" Padding="10,4" Margin="0,2,6,2" Click="OpenQuickLookLog_Click"/>
                                    <Button Content="Restart QuickLook tray" Padding="10,4" Margin="0,2,6,2" Click="RestartQuickLookTray_Click"/>
                                    <Button Content="Refresh thumbnails" Padding="10,4" Margin="0,2,0,2"
                                            ToolTip="Force Explorer to re-query thumbnail handlers for our extensions. Run this if .pdb / .cif files in Icon view show as blank/white icons after install."
                                            Click="RefreshThumbnails_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SidebarBg}"
                    Padding="20,12"
                    BorderBrush="{DynamicResource CardStroke}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusLabel"
                               Text="Changes save instantly."
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="Close" Style="{StaticResource PrimaryButton}"
                            Width="100" Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
