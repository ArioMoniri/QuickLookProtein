<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-side settings UI for QuickLookProtein. WPF + net472 to
    match the plugin's runtime (so the same shared SettingsStore.cs
    works in both processes without recompilation).

    This produces QuickLookProtein.Settings.exe - a regular Windows
    app (not a shell extension), launched from the Start Menu entry
    Setup.exe writes during install. It reads / writes the same
    HKCU\Software\QuickLookProtein\Settings hive that the plugin
    reads on every preview, so a change made here takes effect on
    the user's next Space-bar tap with no IPC or restart.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- ColorDialog is in WinForms; we only use it from MainWindow's
         "Choose color..." button. Cheaper than pulling a 3rd-party
         WPF color-picker NuGet for one dialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QuickLookProtein.Settings</AssemblyName>
    <RootNamespace>QuickLookProtein.Settings</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- File-linked shared source: single source of truth with the
         plugin so no settings drift can happen across the two
         processes. -->
    <Compile Include="..\Shared\SettingsStore.cs">
      <Link>Shared\SettingsStore.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- WebView2 for the live-preview tiles. Same package version as
         the plugin uses so a future bump only happens in one place. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample structure files + shared 3Dmol viewer template + JS.
         These ride along in the Settings install dir so the live-
         preview tiles can render the same way the plugin does, with
         zero duplication of the renderer code. -->
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol.js">
      <Link>SampleAssets\3Dmol.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol_viewer.html">
      <Link>SampleAssets\viewer.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\6oc6.pdb">
      <Link>SampleAssets\sample.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\1565673.cif">
      <Link>SampleAssets\sample.cif</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\PQQ.sdf">
      <Link>SampleAssets\sample.sdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\methane.mol">
      <Link>SampleAssets\sample.mol</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\caffeine.mol2">
      <Link>SampleAssets\sample.mol2</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\benzene.xyz">
      <Link>SampleAssets\sample.xyz</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\water.gro">
      <Link>SampleAssets\sample.gro</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\water.cube">
      <Link>SampleAssets\sample.cube</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\methane.pqr">
      <Link>SampleAssets\sample.pqr</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\QuickLookProtein\Assets\diamond.vasp">
      <Link>SampleAssets\sample.vasp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Promote WebView2Loader.dll's native bridge into OutputPath
       the same way the Plugin csproj does. .NET 6+ does this
       automatically; .NET Framework doesn't. -->
  <Target Name="CopyWebView2LoaderNativeSettings" AfterTargets="Build">
    <ItemGroup>
      <_WebView2NativeS Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebView2NativeS)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_WebView2NativeS.Identity)')" />
  </Target>
</Project>
