<UserControl x:Class="QuickLookProtein.Plugin.MoleculePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#0E0E10">
    <!--
      WebView2 fills the panel. On top, a centered splash is shown while
      WebView2's process boots and 3Dmol.js parses the structure — without
      it the user sees an opaque black window for the ~150-400 ms it takes
      WebView2 to spin up its first navigation. We hide the splash from
      code-behind once the WebView has signalled ContentLoading or
      NavigationCompleted, whichever comes first.

      QL-Win does provide its own busy indicator (ContextObject.IsBusy),
      but that lives in QL-Win's titlebar, not inside this panel. Keeping a
      panel-local splash makes the experience feel native even when the
      titlebar is hidden / minimised.
    -->
    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <!-- Splash: centered glyph + filename + hint. Hidden once the
             WebView begins painting (see code-behind). -->
        <Border x:Name="Splash"
                Background="#0E0E10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="#1A1A1F"
                        BorderBrush="#2A2A30"
                        BorderThickness="1"
                        Margin="0,0,0,12">
                    <TextBlock Text="◇"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="26"
                               Foreground="#7AC1FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SplashTitle"
                           Text="Loading molecule…"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E6E6E8"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashSubtitle"
                           Text="QuickLookProtein · rendered by 3Dmol.js"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           Foreground="#8A8A90"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
