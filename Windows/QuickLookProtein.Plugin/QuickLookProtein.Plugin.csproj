<Project Sdk="Microsoft.NET.Sdk">
  <!--
    QuickLookProtein plugin for QL-Win/QuickLook (https://github.com/QL-Win/QuickLook).
    Builds a single .dll that QL-Win loads when the user previews a molecular
    structure file. The .dll + bundled 3Dmol.js + viewer.html ship as a
    `.qlplugin` archive (a renamed .zip); installing is "drop the .qlplugin
    on QuickLook running in the tray" or "extract into
    %LocalAppData%\QuickLook\plugins\".

    The renderer is identical to the macOS QL extension's: same 3Dmol.js
    bundle, same viewer.html template, same per-format defaults. Only the
    host (WebView2 inside WPF) differs.
  -->
  <PropertyGroup>
    <!--
      MUST target .NET Framework, not .NET 8. QL-Win itself is a
      .NET Framework 4.7.2 application; its CLR cannot load .NET
      Core / .NET 5+ assemblies. A net8.0-windows plugin builds fine
      against QuickLook.Common.dll's API surface but silently fails
      to load at runtime — exactly the symptom the user reported:
      "plugin installs, QuickLook runs, but Space on a .pdb does
      nothing." That's QL-Win logging a TypeLoadException at startup
      and dropping our DLL, with no user-visible feedback.

      LangVersion 10.0 keeps us on file-scoped namespaces and
      nullable-reference-types without needing the .NET 6+ SDK
      target framework — same source compiles cleanly.
    -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickLook.Plugin.Protein</AssemblyName>
    <RootNamespace>QuickLookProtein.Plugin</RootNamespace>
    <!--
      Force x64 so WebView2Loader.dll resolution lands on the x64
      native binary at runtime. QL-Win is an x64 process, so this
      matches the host.
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    The Microsoft.Web.WebView2 NuGet ships its native bridge
    (WebView2Loader.dll) under runtimes/win-{arch}/native/. On .NET 6+
    SDK these get auto-deployed to the output folder via the
    `runtimes` build target. On .NET Framework projects (which is
    what QL-Win requires us to target) that auto-deploy DOESN'T
    happen, so the assembly loads but its first WebView2 call hits
    DllNotFoundException(WebView2Loader.dll). QL-Win catches that
    and silently drops our plugin, falling back to its built-in
    text viewer - which is exactly what the user saw (raw .pdb
    rendered as plain text after install).

    Manually copy the right architecture's WebView2Loader.dll into
    OutputPath as a post-build step.
  -->
  <Target Name="CopyWebView2LoaderNative" AfterTargets="Build">
    <ItemGroup>
      <_WebView2Native Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebView2Native)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_WebView2Native.Identity)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for the registry-backed settings store
         is Windows/Shared/SettingsStore.cs. Both the plugin and the
         standalone Settings WPF app compile that same file via this
         link rather than depending on a separate shared assembly,
         which would mean shipping a third DLL inside the .qlplugin. -->
    <Compile Include="..\Shared\SettingsStore.cs">
      <Link>Shared\SettingsStore.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      QuickLook.Common.dll is loaded by the QL-Win host process at runtime.
      We only need the API surface to compile against — Private=False keeps
      it out of our output so we don't ship two copies (which would crash
      the host with a type-identity mismatch on IViewer).
      The libs/ dir is populated by the GitHub Actions workflow that
      downloads the matching QL-Win release; locally, place
      QuickLook.Common.dll there from any recent QL-Win release zip.
    -->
    <Reference Include="QuickLook.Common">
      <HintPath>libs\QuickLook.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Reuse the macOS app's existing 3Dmol bundle and viewer template so
      the Windows preview is visually identical and there's one source of
      truth for renderer changes. MSBuild links them in under Resources/
      in the plugin output.
    -->
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol.js">
      <Link>Resources\3Dmol.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol_viewer.html">
      <Link>Resources\viewer.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
