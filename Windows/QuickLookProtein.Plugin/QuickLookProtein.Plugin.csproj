<Project Sdk="Microsoft.NET.Sdk">
  <!--
    QuickLookProtein plugin for QL-Win/QuickLook (https://github.com/QL-Win/QuickLook).
    Builds a single .dll that QL-Win loads when the user previews a molecular
    structure file. The .dll + bundled 3Dmol.js + viewer.html ship as a
    `.qlplugin` archive (a renamed .zip); installing is "drop the .qlplugin
    on QuickLook running in the tray" or "extract into
    %LocalAppData%\QuickLook\plugins\".

    The renderer is identical to the macOS QL extension's: same 3Dmol.js
    bundle, same viewer.html template, same per-format defaults. Only the
    host (WebView2 inside WPF) differs.
  -->
  <PropertyGroup>
    <!--
      MUST target .NET Framework, not .NET 8. QL-Win itself is a
      .NET Framework 4.7.2 application; its CLR cannot load .NET
      Core / .NET 5+ assemblies. A net8.0-windows plugin builds fine
      against QuickLook.Common.dll's API surface but silently fails
      to load at runtime — exactly the symptom the user reported:
      "plugin installs, QuickLook runs, but Space on a .pdb does
      nothing." That's QL-Win logging a TypeLoadException at startup
      and dropping our DLL, with no user-visible feedback.

      LangVersion 10.0 keeps us on file-scoped namespaces and
      nullable-reference-types without needing the .NET 6+ SDK
      target framework — same source compiles cleanly.
    -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickLook.Plugin.Protein</AssemblyName>
    <RootNamespace>QuickLookProtein.Plugin</RootNamespace>
    <!--
      AnyCPU, NOT x64. A user diagnostic on 1.7.69 showed
      BadImageFormatException ("An attempt was made to load a
      program with an incorrect format.") because QL-Win on their
      machine was running as 32-bit (x86), and our x64-marked
      plugin DLL refused to load into the 32-bit process. QL-Win's
      own exe is AnyCPU with Prefer32Bit, so it can run either way
      depending on Windows configuration - we have to match.

      AnyCPU lets the CLR load the assembly in whatever bitness the
      host process happens to be in. Microsoft.Web.WebView2 managed
      wrappers are themselves AnyCPU and pick the correct native
      WebView2Loader.dll at runtime based on
      Environment.Is64BitProcess. We ship both x86 and x64 loaders
      so neither bitness is left without its native bridge - see
      the CopyWebView2LoaderNative target below.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <!--
      Without an explicit version MSBuild defaults to 1.0.0.0 for
      both AssemblyVersion and FileVersion, which made the support
      diagnostic
        (Get-Item ...\QuickLook.Plugin.Protein.dll).VersionInfo.FileVersion
      always print "1.0.0.0" regardless of marketing release. We
      bake the marketing version into FileVersion + InformationalVersion
      so users running the diagnostic can confirm at a glance whether
      they're on the build that contains the fix.

      AssemblyVersion stays at 1.0 (no semver minor bumps for binary
      compat) - QL-Win's plugin loader doesn't care about it, but
      anything else linking against this DLL would, so we leave it
      stable.

      The release workflow rewrites <Version> at build time via the
      `dotnet build /p:Version=...` flag so a tag push of v1.7.69
      produces a DLL whose FileVersion is 1.7.69. The default below
      makes local dev builds identifiable as "0.0.0-dev".
    -->
    <!--
      `dotnet build /p:Version=X.Y.Z` only flows through to FileVersion
      and InformationalVersion automatically when those properties
      AREN'T explicitly set. Our diagnostic from 1.7.69 confirmed
      "strings" against the shipped DLL showed only "1.0.0.0" — i.e.
      the SDK's auto-FileVersion-from-Version logic was being masked
      by the explicit `<AssemblyVersion>` line below. Restate
      FileVersion and InformationalVersion as derived from $(Version)
      so the override path is unambiguous: passing /p:Version at
      build time updates both, while local dev builds get 0.0.0-dev
      stamped instead of nothing.
    -->
    <!--
      Local dev builds stamp 0.0.0 so a stray dev .dll doesn't look
      like a released build in the diagnostic block. Release builds
      override everything explicitly via:
          dotnet build /p:Version=$VER /p:FileVersion=$VER /p:InformationalVersion=$VER
      Setting all three keeps the override path direct - no
      derivation logic in MSBuild's "make Version from VersionPrefix
      and VersionSuffix" middle layer to second-guess. AssemblyVersion
      stays at 1.0.0.0 (QL-Win's plugin loader ignores it; bumping
      it would force a redeploy of anything that pinned us via
      strong name).
    -->
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    The Microsoft.Web.WebView2 NuGet ships its native bridge
    (WebView2Loader.dll) under runtimes/win-{arch}/native/. On .NET 6+
    SDK these get auto-deployed to the output folder via the
    `runtimes` build target. On .NET Framework projects (which is
    what QL-Win requires us to target) that auto-deploy DOESN'T
    happen, so the assembly loads but its first WebView2 call hits
    DllNotFoundException(WebView2Loader.dll). QL-Win catches that
    and silently drops our plugin, falling back to its built-in
    text viewer - which is exactly what the user saw (raw .pdb
    rendered as plain text after install).

    Ship BOTH bitnesses' WebView2Loader.dll so a QL-Win host
    running 32-bit (x86, WOW64) and one running 64-bit (x64) both
    get their matching native bridge. The managed wrapper
    (Microsoft.Web.WebView2.Core.dll) is AnyCPU and at runtime
    P/Invokes WebView2Loader using a path that includes the
    process's bitness folder, so dropping both copies under
    runtimes/win-x64/native/ and runtimes/win-x86/native/ lets the
    wrapper find the right one without any code changes here.

    Also drop a copy of the 64-bit loader at the plugin folder
    root for backwards compat with the 1.7.69 install layout - the
    1.7.69 install.ps1 already lifts that flat file if it's
    present, and Microsoft.Web.WebView2.Core falls back to looking
    next to its own DLL.
  -->
  <Target Name="CopyWebView2LoaderNative" AfterTargets="Build">
    <ItemGroup>
      <_WebView2Native64 Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\runtimes\win-x64\native\WebView2Loader.dll" />
      <_WebView2Native86 Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\runtimes\win-x86\native\WebView2Loader.dll" />
    </ItemGroup>
    <!-- runtimes/win-x64/native/WebView2Loader.dll -->
    <Copy SourceFiles="@(_WebView2Native64)"
          DestinationFolder="$(OutputPath)runtimes\win-x64\native"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_WebView2Native64.Identity)')" />
    <!-- runtimes/win-x86/native/WebView2Loader.dll -->
    <Copy SourceFiles="@(_WebView2Native86)"
          DestinationFolder="$(OutputPath)runtimes\win-x86\native"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_WebView2Native86.Identity)')" />
    <!-- Flat-folder fallback (1.7.69-and-earlier install layout):
         use the 64-bit loader since QL-Win usually runs AnyCPU and
         x64 is the more common case. install.ps1 will keep this. -->
    <Copy SourceFiles="@(_WebView2Native64)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_WebView2Native64.Identity)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for the registry-backed settings store
         is Windows/Shared/SettingsStore.cs. Both the plugin and the
         standalone Settings WPF app compile that same file via this
         link rather than depending on a separate shared assembly,
         which would mean shipping a third DLL inside the .qlplugin. -->
    <Compile Include="..\Shared\SettingsStore.cs">
      <Link>Shared\SettingsStore.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      QuickLook.Common.dll is loaded by the QL-Win host process at runtime.
      We only need the API surface to compile against — Private=False keeps
      it out of our output so we don't ship two copies (which would crash
      the host with a type-identity mismatch on IViewer).
      The libs/ dir is populated by the GitHub Actions workflow that
      downloads the matching QL-Win release; locally, place
      QuickLook.Common.dll there from any recent QL-Win release zip.
    -->
    <Reference Include="QuickLook.Common">
      <HintPath>libs\QuickLook.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Reuse the macOS app's existing 3Dmol bundle and viewer template so
      the Windows preview is visually identical and there's one source of
      truth for renderer changes. MSBuild links them in under Resources/
      in the plugin output.
    -->
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol.js">
      <Link>Resources\3Dmol.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Xcode\Shared\Assets\3Dmol_viewer.html">
      <Link>Resources\viewer.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
